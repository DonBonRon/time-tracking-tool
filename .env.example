# ---------------------------------------------------------------
# Zeiterfassung – Konfiguration
# Datei nach `.env` kopieren und anpassen. Alternativ die Werte als
# Umgebungsvariablen im Hosting-Panel (Plesk/cPanel) eintragen.
# ---------------------------------------------------------------

# Öffentliche Adresse der App (für Links in E-Mails)
APP_URL=https://zeit.example.de

# Port – bei Plesk/cPanel (Passenger) wird PORT automatisch gesetzt
PORT=3000

# --- MySQL / MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=timetrack
DB_PASSWORD=bitte-aendern
DB_NAME=timetrack
# Alternativ alles in einer Zeile:
# DATABASE_URL=mysql://timetrack:passwort@localhost:3306/timetrack
# Oder per Unix-Socket:
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# --- Anmeldung ---
# Nur für den allerersten Start: setzt das Passwort, falls noch keins existiert.
# Danach wieder entfernen (oder gleich `npm run set-password` verwenden).
APP_PASSWORD=

# Läuft die App hinter einem Reverse Proxy (Plesk, cPanel, nginx, Caddy)? Dann 1.
# Nur auf 0 setzen, wenn Node direkt aus dem Internet erreichbar ist.
TRUST_PROXY=1

# Cookies nur über HTTPS senden (Standard). Nur für lokale Tests auf false setzen.
COOKIE_SECURE=true

# --- E-Mail (SMTP) ---
SMTP_HOST=smtp.example.de
SMTP_PORT=587
# true bei Port 465 (SSL), sonst false (STARTTLS)
SMTP_SECURE=false
SMTP_USER=zeit@example.de
SMTP_PASS=bitte-aendern
MAIL_FROM=Zeiterfassung <zeit@example.de>
MAIL_TO=du@example.de

# Ab welcher Stunde (Serverzeit) Monats-/Wochenberichte verschickt werden
REPORT_HOUR=7

# Zeitzone für Monatsgrenzen und Uhrzeiten in Mails
TZ=Europe/Berlin

# --- Hintergrund-Jobs ---
# Interner Takt in Sekunden für Erinnerungen und Berichte (0 = aus)
JOB_INTERVAL=60
# Geheimer Schlüssel für den Cron-Endpunkt /api/cron?key=…
# Nötig, wenn das Hosting die App im Leerlauf schlafen legt (Passenger).
# Erzeugen z. B. mit: openssl rand -hex 24
CRON_SECRET=
