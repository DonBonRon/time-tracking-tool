# ---------------------------------------------------------------
# Time Tracking Tool – configuration
# Copy this file to `.env` and adjust it. Alternatively, set the values
# as environment variables in your hosting panel (Plesk/cPanel).
# ---------------------------------------------------------------

# Public URL of the app (used for links in emails)
APP_URL=https://time.example.com

# Port – set automatically by Plesk/cPanel (Passenger)
PORT=3000

# --- MySQL / MariaDB ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=timetrack
DB_PASSWORD=change-me
DB_NAME=timetrack
# Or as a single connection string:
# DATABASE_URL=mysql://timetrack:password@localhost:3306/timetrack
# Or via Unix socket:
# DB_SOCKET=/var/run/mysqld/mysqld.sock

# --- Login ---
# Only for the very first start: sets the password if none exists yet.
# Remove it afterwards (or use `npm run set-password` instead).
APP_PASSWORD=

# Running behind a reverse proxy (Plesk, cPanel, nginx, Caddy)? Then 1.
# Only set to 0 if Node.js is directly reachable from the internet.
TRUST_PROXY=1

# Send cookies over HTTPS only (default). Set to false for local testing only.
COOKIE_SECURE=true

# --- Email (SMTP) ---
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (SSL), otherwise false (STARTTLS)
SMTP_SECURE=false
SMTP_USER=time@example.com
SMTP_PASS=change-me
MAIL_FROM=Time Tracking <time@example.com>
MAIL_TO=you@example.com

# Hour of day (server time) from which monthly/weekly reports are sent
REPORT_HOUR=7

# Time zone for month boundaries and times in emails
TZ=Europe/Berlin

# --- Background jobs ---
# Internal interval in seconds for reminders and reports (0 = off)
JOB_INTERVAL=60
# Secret key for the cron endpoint /api/cron?key=…
# Needed if your host puts the app to sleep when idle (Passenger).
# Generate one with e.g.: openssl rand -hex 24
CRON_SECRET=
