{
  "name": "time-tracking-tool",
  "version": "1.1.2",
  "private": true,
  "description": "Minimal self-hosted time tracker for client work (single user, offline-capable PWA, Node.js + MySQL)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/donbonron/time-tracking-tool.git"
  },
  "keywords": [
    "time-tracking",
    "timesheet",
    "pwa",
    "offline-first",
    "self-hosted",
    "mysql",
    "freelancer"
  ],
  "type": "module",
  "main": "app.cjs",
  "scripts": {
    "start": "node server/index.js",
    "dev": "COOKIE_SECURE=false node --watch server/index.js",
    "set-password": "node scripts/set-password.js"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "express": "^5.3.0",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.2.1"
  }
}
